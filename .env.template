# Copy to .env and fill in. Never commit .env.

# --- AWS ---
AWS_REGION=us-east-1

# --- Bedrock model (placeholder — set to your approved Claude model id) ---
MODEL_ID=REPLACE_WITH_YOUR_CLAUDE_MODEL_ID

# --- HealthLake ---
HEALTHLAKE_DATASTORE_ID=REPLACE_WITH_DATASTORE_ID
# Endpoint is derived from datastore id + region if left blank.
HEALTHLAKE_ENDPOINT=

# --- S3 documents ---
DOCS_S3_BUCKET=REPLACE_WITH_BUCKET_NAME
DOCS_S3_PREFIX=clinical/

# --- Identity (scope every tool call to the caller) ---
IDENTITY_PROVIDER=cognito
COGNITO_USER_POOL_ID=REPLACE_WITH_POOL_ID

# --- Limits ---
MAX_DOCUMENT_BYTES=52428800
PRESIGNED_URL_TTL_SECONDS=3600
